# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini AI (server only - optional unless AI features are used; Free Tier default: gemini-3.8-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional request tuning (bounds: timeout 1000-120000 ms, retries 0-5)
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_RETRIES=2

# PayPal Complete Payments Platform (Multiparty) Sandbox (server-only secrets)
# Strictly Sandbox in Phase 3B. Production environments and live endpoints are rejected.
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_PAYMENT_MODE=PLATFORM
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_EXPECTED_MERCHANT_ID=
# Optional dedicated Multiparty Platform client credentials (fall back to PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET if both omitted; must be paired symmetrically if set)
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=
# Required when PAYPAL_PAYMENT_MODE=PLATFORM (must be PayRoost's own sandbox Partner/Platform merchant ID, 3-64 chars)
PAYPAL_PARTNER_MERCHANT_ID=
# Optional: only set to an actual PayPal-issued Partner Attribution ID (BN code). Leave empty to omit header. (Legacy alias PAYPAL_BN_CODE is also accepted as fallback.)
PAYPAL_PARTNER_ATTRIBUTION_ID=
# Required for webhook signature verification (8-128 chars: A-Z, a-z, 0-9, _, -)
PAYPAL_WEBHOOK_ID=
# Currently unused in runtime code (PayRoost uses server-created PayPal approval redirect URLs)
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Application URL
# PAYROOST_APP_URL is checked before NEXT_PUBLIC_APP_URL for server redirects, OAuth callbacks, PayPal return URLs, and email links.
# Production strictly requires a valid HTTPS non-localhost origin without credentials, query string, or hash.
PAYROOST_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Delivery (Resend)
RESEND_API_KEY=
PAYROOST_EMAIL_FROM=Payroost <onboarding@resend.dev>

# Security Secrets (server only)
# Required in development & production (>= 32 UTF-8 bytes; rejects placeholder values) for review OTP hashing
PAYROOST_OTP_SECRET=
# Required in production (>= 32 UTF-8 bytes; dev/test falls back if unset) for client-portal OTP HMAC verification
PORTAL_OTP_HMAC_SECRET=
# Required in all environments (>= 32 UTF-8 bytes; rejects trivial/placeholder values) when AI scope-change analysis or snapshot verification runs
PAYROOST_AI_SNAPSHOT_SECRET=
# Optional cron bearer token for POST /api/internal/payments/recover (min 16 chars when used)
CRON_SECRET=

# Proxy Trust Configuration (server only)
# Disabled by default. Only set to "true" if the application is deployed behind
# a trusted reverse proxy that is explicitly configured to sanitize or overwrite
# incoming forwarding headers (X-Real-IP and X-Forwarded-For).
TRUST_PROXY=false


# Do not add real credentials to this file. Use .env.local locally and your
# hosting provider's encrypted environment configuration in deployed builds.
