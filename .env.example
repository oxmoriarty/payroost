# =============================================================================
# PayRoost Environment Variables Template
# Copy to .env.local for local development (never commit real secrets).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required server-only key for privileged verification, portal, and payment RPCs
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Google Gemini AI (Server-only, Optional unless AI features are used)
# -----------------------------------------------------------------------------
# Optional: omit if AI features (briefs, agreements, milestones, assistant) are unused
GEMINI_API_KEY=
# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# PayPal Sandbox (Server-only secrets; strictly Sandbox)
# -----------------------------------------------------------------------------
# Required
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_EXPECTED_MERCHANT_ID=
# Required when PAYPAL_PAYMENT_MODE=PLATFORM (PayRoost Sandbox Partner/Platform Merchant ID, 3-64 chars)
PAYPAL_PARTNER_MERCHANT_ID=
# Required for verifying incoming PayPal webhook signatures (8-128 chars)
PAYPAL_WEBHOOK_ID=

# Optional PayPal overrides (defaults shown)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_PAYMENT_MODE=PLATFORM
# Optional dedicated Platform app credentials (falls back to PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET when omitted; pair both if set)
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=
# Optional PayPal Partner Attribution ID (BN code); leave blank if unassigned
PAYPAL_PARTNER_ATTRIBUTION_ID=

# -----------------------------------------------------------------------------
# Application URL
# -----------------------------------------------------------------------------
# Required in production as a valid HTTPS non-localhost origin (checked before NEXT_PUBLIC_APP_URL)
PAYROOST_APP_URL=http://localhost:3000
# Optional public fallback origin for browser/client links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Email Delivery (Gmail SMTP via nodemailer; server-only)
# -----------------------------------------------------------------------------
# Required for sending verification links, portal invitations, and 6-digit OTPs
SMTP_USER=
# Use a 16-character Google App Password when using Gmail SMTP
SMTP_PASS=
# Optional SMTP connection overrides (defaults target Gmail SMTP over SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Optional sender display header (defaults to "Payroost <SMTP_USER>")
PAYROOST_EMAIL_FROM=

# -----------------------------------------------------------------------------
# Security Secrets (Server-only)
# -----------------------------------------------------------------------------
# Required in development & production (>= 32 bytes; no placeholder values) for review OTP hashing
PAYROOST_OTP_SECRET=
# Required in production (>= 32 bytes; dev/test falls back when omitted) for client portal OTP verification
PORTAL_OTP_HMAC_SECRET=
# Required when AI scope-change snapshot signing/verification runs (>= 32 bytes)
PAYROOST_AI_SNAPSHOT_SECRET=
# Optional bearer token for scheduled recovery calls to POST /api/internal/payments/recover (>= 16 chars when used)
CRON_SECRET=

# -----------------------------------------------------------------------------
# Reverse Proxy Trust (Server-only, Optional)
# -----------------------------------------------------------------------------
# Optional (defaults to false). Set to "true" ONLY behind a trusted proxy that overwrites X-Real-IP / X-Forwarded-For.
TRUST_PROXY=false
